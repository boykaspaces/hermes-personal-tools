{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyHermesGatewayClientToken",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:personal-tools-hermes-client-token-*"
    },
    {
      "Sid": "PopulateButDoNotReadGoogleWorkspaceCredential",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:personal-tools-google-workspace-oauth-*"
    },
    {
      "Sid": "PopulateButDoNotReadGitHubAppPrivateKey",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:personal-tools-github-app-private-key-*"
    }
  ]
}
